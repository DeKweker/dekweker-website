{
  "routes": [
    {
      "src": "^/(.*)$",
      "continue": true,
      "headers": {
        "Strict-Transport-Security": "max-age=31536000; includeSubDomains; preload",
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "accelerometer=(), autoplay=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()",
        "Content-Security-Policy": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; script-src 'self' 'unsafe-inline' https:; connect-src 'self' https:; frame-src https://www.youtube.com https://www.youtube-nocookie.com https://open.spotify.com https://w.soundcloud.com https://soundcloud.com https://embed.music.apple.com https://music.apple.com; object-src 'none'; base-uri 'self'; form-action 'self' mailto:"
      }
    },

    { "src": "^/assets/data/(.*)\\.json$", "continue": true, "headers": { "Cache-Control": "public, max-age=300, stale-while-revalidate=900" } },
    { "src": "^/media/mentions\\.json$", "continue": true, "headers": { "Cache-Control": "public, max-age=300, stale-while-revalidate=900" } },
    { "src": "^/(assets/(?!data/)|css/|js/)(.*)$", "continue": true, "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "src": "^/(favicon\\.ico|apple-touch-icon\\.png|favicon-16x16\\.png|favicon-32x32\\.png|favicon-96x96\\.png|site\\.webmanifest)$", "continue": true, "headers": { "Cache-Control": "public, max-age=604800" } },
    { "src": "^/muziek/?$", "continue": true, "headers": { "Cache-Control": "no-store, no-cache, must-revalidate" } },
    { "src": "^/muziek/index\\.html$", "continue": true, "headers": { "Cache-Control": "no-store, no-cache, must-revalidate" } },
    { "src": "^/live/?$", "continue": true, "headers": { "Cache-Control": "no-store, no-cache, must-revalidate" } },
    { "src": "^/live/index\\.html$", "continue": true, "headers": { "Cache-Control": "no-store, no-cache, must-revalidate" } },

    { "src": "^/site\\.html$", "continue": true, "headers": { "X-Robots-Tag": "noindex, nofollow, noarchive, noimageindex" } },
    { "src": "^/maintenance\\.html$", "continue": true, "headers": { "X-Robots-Tag": "noindex, nofollow, noarchive" } },

    { "src": "^/context/?$", "dest": "/context/index.html", "headers": { "X-Robots-Tag": "noindex, nofollow, noarchive" } },
    { "src": "^/context/(.*)$", "dest": "/context/$1", "headers": { "X-Robots-Tag": "noindex, nofollow, noarchive" } },
    { "src": "^/mediakit/?$", "dest": "/mediakit/index.html", "headers": { "X-Robots-Tag": "noindex, nofollow, noarchive" } },
    { "src": "^/mediakit/(.*)$", "dest": "/mediakit/$1", "headers": { "X-Robots-Tag": "noindex, nofollow, noarchive" } },

    { "src": "^/de-kweker$", "dest": "/de-kweker/index.html" },
    { "src": "^/de-kweker/$", "dest": "/de-kweker/index.html" },
    { "src": "^/live$", "dest": "/live/index.html" },
    { "src": "^/live/$", "dest": "/live/index.html" },
    { "src": "^/media$", "dest": "/media/index.html" },
    { "src": "^/media/$", "dest": "/media/index.html" },
    { "src": "^/sporen$", "dest": "/media/index.html" },
    { "src": "^/sporen/$", "dest": "/media/index.html" },
    { "src": "^/privacy$", "dest": "/privacy/index.html" },
    { "src": "^/privacy/$", "dest": "/privacy/index.html" },

    { "handle": "filesystem" }
  ]
}
